---
interface Props {
    motto: string;
}

const { motto } = Astro.props;
---

<header class="bg-background-500 font-bold p-8 m-5 rounded-xl">
    <h1 class="text-3xl text-center p-1"><slot /></h1>
    <h3 class="text-1xl text-center font-normal">{motto}</h3>
</header>

<style>
    a:hover {
        text-decoration-line: underline;
    }
</style>
